# Copy to .env.local and fill in real values. Never commit .env.local.
# Placeholder values only in this file.

# --- Public Firebase web config (safe for the browser) ---
# Firebase console > Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# --- AI assistant (server-only) ---
# Google Gemini API key from https://aistudio.google.com/apikey (free tier).
# Without it the assistant shows "not configured"; the rest of the app works.
AI_API_KEY=
# Optional. Only "gemini" is supported for now.
AI_PROVIDER=gemini
# Optional. Any Gemini text model id; default gemini-3.5-flash-lite.
AI_MODEL=gemini-3.5-flash-lite
# Optional. Questions per user per day (protects the free quota); default 30.
AI_DAILY_LIMIT=30
