rules_version = '2';

// Deny by default. Business data is read and written through server-side
// Route Handlers using the Admin SDK, which checks ownership explicitly.
// Add narrow client rules only when a phase needs direct client access, and
// test them with the emulator (see AGENTS.md section 8).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
